{
  "name": "agente-contratos-aluguel",
  "version": "1.0.0",
  "description": "Agente que lê contratos de aluguel em PDF, calcula vencimentos e reajustes e gera relatório em PDF ou planilha (projeto de estudo de QA).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/gerar-contratos.js",
    "start": "node src/index.js",
    "contratos": "node scripts/gerar-contratos.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "avaliar": "node scripts/avaliar-agente.js",
    "cy:open": "cypress open",
    "test:api": "cypress run --spec \"cypress/e2e/api/**\"",
    "test:ui": "cypress run --spec \"cypress/e2e/ui/**\"",
    "test:e2e": "cypress run"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^10.1.10",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "pdfkit": "^0.20.2",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "cypress": "^16.2.1",
    "vitest": "^5.1.0"
  }
}
